# Скопіюйте цей файл у .env і заповніть своїми значеннями.
# Файл .env НЕ комітьте і не завантажуйте нікуди публічно.

# Довільний випадковий рядок (для підпису сесій). Згенерувати можна так:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Пароль, яким ви будете входити у застосунок з телефона
APP_PASSWORD=

# ID вашої Google-таблиці (з URL: https://docs.google.com/spreadsheets/d/ЦЕЙ_ID/edit)
GOOGLE_SHEET_ID=

# Вміст JSON-ключа сервісного акаунта Google, в один рядок (див. README)
GOOGLE_CREDENTIALS_JSON=

# Необов'язково: ключ OpenAI API. Якщо задано, нові категорії/підкатегорії
# без emoji автоматично отримують підходящу emoji від LLM при додаванні чи
# перейменуванні. Без ключа (або за будь-якого збою LLM) категорія просто
# зберігається без emoji, а користувач бачить попередження в інтерфейсі.
OPENAI_API_KEY=

# Необов'язково: модель OpenAI для підбору emoji (за замовчуванням gpt-4o-mini)
OPENAI_MODEL=

# Необов'язково: розсилка звітів електронною поштою через Resend
# (https://resend.com) — за вчора автоматично при першому запиті процесу
# після сну, або за обраний період вручну кнопкою 📧 в інтерфейсі.
# RESEND_API_KEY — send-only ключ (Resend Dashboard → API Keys), не дає
# доступу до жодної поштової скриньки, на відміну від Gmail App Password.
# RESEND_FROM_EMAIL — адреса відправника; для власного домену потрібно
# верифікувати його в Resend (Dashboard → Domains), інакше залиште
# значення за замовчуванням (onboarding@resend.dev, працює без верифікації,
# але тільки для надсилання на вашу власну зареєстровану в Resend адресу).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
DAILY_REPORT_EMAIL=
